{
  "expo": {
    "name": "PHC Auto",
    "slug": "phc-auto",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "phcauto",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#121315",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phcauto.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.phcauto.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#121315",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121315",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O PHC Auto usa sua localização aproximada para mostrar veículos e lojas perto de você."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#cd1923"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6839a657-0b32-4290-b3e4-cff9da592fe4"
      }
    },
    "owner": "joaochecchia"
  }
}
